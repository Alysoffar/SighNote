{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://notes.app/schemas/payloads/cancel.schema.json",
  "title": "CancelPayload",
  "description": "Payload sent by client to cancel an in-flight request.",
  "type": "object",
  "required": ["target_id"],
  "properties": {
    "target_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID of the request to cancel"
    },
    "reason": {
      "type": "string",
      "description": "Optional human-readable cancellation reason"
    }
  },
  "additionalProperties": false
}
