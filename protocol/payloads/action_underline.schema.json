{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://notes.app/schemas/payloads/action_underline.schema.json",
  "title": "ActionUnderlinePayload",
  "description": "Payload sent by server to draw an error underline on the canvas. Must anchor to a line_id with fallback bounding box.",
  "type": "object",
  "required": ["action_id", "page_rev", "line_id", "fallback_bbox", "color", "style"],
  "properties": {
    "action_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this action"
    },
    "page_rev": {
      "type": "integer",
      "minimum": 0,
      "description": "Page revision against which the action was computed"
    },
    "line_id": {
      "type": "string",
      "format": "uuid",
      "description": "Line ID to which this action is anchored"
    },
    "fallback_bbox": {
      "type": "object",
      "required": ["min_x", "min_y", "max_x", "max_y"],
      "properties": {
        "min_x": { "type": "number" },
        "min_y": { "type": "number" },
        "max_x": { "type": "number" },
        "max_y": { "type": "number" }
      },
      "additionalProperties": false,
      "description": "Fallback bounding box in page-space"
    },
    "color": {
      "type": "string",
      "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
      "description": "Hex color code e.g. #FF0000 or #FF0000FF"
    },
    "style": {
      "type": "string",
      "enum": ["solid", "wavy", "dashed"],
      "description": "Visual style of the underline"
    },
    "explanation": {
      "type": "string",
      "description": "Optional text explanation of the error"
    }
  },
  "additionalProperties": false
}
