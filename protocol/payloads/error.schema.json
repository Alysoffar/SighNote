{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://notes.app/schemas/payloads/error.schema.json",
  "title": "ErrorPayload",
  "description": "Payload sent by server when an error occurs processing a request.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "description": "Machine-readable error code"
    },
    "message": {
      "type": "string",
      "description": "Human-readable error description"
    },
    "details": {
      "type": ["string", "object", "null"],
      "description": "Optional debugging or schema validation details"
    }
  },
  "additionalProperties": false
}
